# The measures of the benchmark (bench/ in the repository), shown by the
# home page and the Performance page. Requests per second.

pipeline_millions = 2.0
cache_ns = 73

## Facile and Vitesse measured in turn (bench/ab.sh), 7 rounds each, 128 connections:
## the fairest comparison. Neck and neck since Vitesse has an engine per thread.
