## The texts of a language: `textes("fr")`.
fn textes(lang) = if lang == "en" then en else fr

## The address of the site, for the sitemap.
site_url = unwrap_or(env("SITE_URL"), "https://facile.rythme.dev")

## A path of the site in a language: `lien("en", "/docs/start")` is `/en/docs/start`.
fn lien(lang, chemin) = match [lang, chemin]
  ["en", "/"] -> "/en/"
  ["en", c] -> "/en" + c
  [_, c] -> c
end
